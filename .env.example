# Copy this file to .env and fill in your values. Never commit the real .env.

# Create an API key at https://www.remove.bg/api
REMOVE_BG_API_KEY=your_remove_bg_api_key_here
# Public monthly quota shown by the frontend. New databases start at 4 used requests for testing.
REMOVE_BG_MONTHLY_LIMIT=50
REMOVE_BG_INITIAL_USAGE=4
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-image
HF_API_TOKEN=
HF_ENHANCE_MODEL=caidas/swin2SR-classical-sr-x2-64

# Admin credentials (generate a password hash with the README command).
ADMIN_USERNAME=Admin
ADMIN_PASSWORD_HASH=your_scrypt_password_hash_here
# Use a random URL-safe value of at least 8 characters; do not share it.
ADMIN_PATH_SECRET=your_random_admin_path_secret_here

# Port the backend listens on
PORT=8787

# Comma-separated list of frontend origins allowed to call this backend.
# Use * only while testing locally.
ALLOWED_ORIGINS=*

# Set true when serving over HTTPS (recommended for production).
# Local HTTP development can leave this false.
ADMIN_COOKIE_SECURE=false

# Monetization (Razorpay values are server-only; leave blank to disable payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Generate with: node admin/generate-supervisor-hash.js "your-private-code"
SUPERVISOR_CODE_HASH=
# Set true behind HTTPS so the anonymous wallet cookie works cross-origin.
COOKIE_SECURE=false
